# ─────────────────────────────────────────────
# MelodyTab AI — Variáveis de Ambiente
# ─────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores:
# cp .env.example .env

# Groq API (Whisper + LLaMA)
# Obter em: https://console.groq.com
GROQ_API_KEY=

# Replicate API (Fallback Demucs + CREPE)
# Obter em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# HuggingFace API (Fallback Basic Pitch)
# Obter em: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# ─────────────────────────────────────────────
# Configurações da Aplicação
# ─────────────────────────────────────────────

# Tamanho máximo do arquivo de upload em MB
MAX_AUDIO_SIZE_MB=50

# Modelo do Demucs a utilizar
# Opções: htdemucs (rápido) | htdemucs_ft (melhor qualidade)
DEMUCS_MODEL=htdemucs

# Idioma padrão para transcrição do Whisper
# Exemplos: pt, en, es
WHISPER_LANGUAGE=pt